# Copy to .env (gitignored) before running `docker compose up`. These are throwaway local
# development credentials for containers that only ever listen on localhost - never real secrets,
# and never used anywhere but this compose file (docs/architecture/repositories.md: "no secrets,
# ever" - local values live in gitignored files, the repository carries .example files only).

POSTGRES_USER=ago
POSTGRES_PASSWORD=ago-local-dev
POSTGRES_DB=ago_chat

RABBITMQ_USER=ago
RABBITMQ_PASSWORD=ago-local-dev

MINIO_ROOT_USER=ago
MINIO_ROOT_PASSWORD=ago-local-dev

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=ago-local-dev

# `15-01`: Keycloak's own Postgres role (database `keycloak`, same Postgres server as the app's own
# database - adr/0036). Created and kept in sync by the keycloak-db-init step, so changing it here and
# restarting Keycloak is a complete password rotation.
KEYCLOAK_DB_PASSWORD=ago-local-dev

# `7-03`: Grafana admin user - same env-var-driven, no-committed-secret-value shape as Keycloak above.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ago-local-dev

# `10-05`: where Keycloak sends its verification and password-reset mail. Locally that is the mailpit
# sink in this same compose file - it accepts everything on 1025, forwards nothing, and shows the
# result at http://localhost:8025. No credentials here because there is nothing to authenticate to,
# which is the whole reason a sink is used locally rather than a real provider.
#
# These are read by `k8s/apply-smtp-settings.sh`, not by Keycloak: SMTP is a realm setting, so it has
# to be applied to the realm after the stack is up. `docker compose up` alone does not send mail.
#
#   cd C:/git/ago/ago-deploy
#   k8s/apply-smtp-settings.sh compose
#
# The address below is deliberately in `.local`, a reserved name that can never resolve to anyone real
# (RFC 6762) - a local sink should be incapable of impersonating the actual sending domain.
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@ago-chat.local
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=AGO Chat (local)
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_SSL=false
