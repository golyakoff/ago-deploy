{
  "realm": "ago-chat",
  "displayName": "AGO Chat",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined) and passwordHistory(3)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 14400,
  "ssoSessionMaxLifespan": 43200,
  "offlineSessionIdleTimeout": 604800,
  "actionTokenGeneratedByUserLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "platform-owner",
        "description": "12-01/adr/0032: platform owner - operator of the service itself, not of any one tenant. Defined here, never assigned here (this file also provisions the public demo realm). Grant by hand: Realm roles > platform-owner > Users in role."
      }
    ]
  },
  "clients": [
    {
      "clientId": "ago-console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:5173/*",
        "https://office.reserve-me.ru/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173",
        "https://office.reserve-me.ru"
      ],
      "protocolMappers": [
        {
          "name": "ago-console-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ago-console",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ago-calendar-console",
      "name": "AGO Calendar console (20-20)",
      "description": "adr/0027: Calendar resolves its own Operator from this same realm, so it needs its own client - never ago-console's. The token this client mints is validated by Ago.Calendar.Api (Operator:Authority/Operator:Audience), never by Ago.Chat.Api.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "https://calendar.reserve-me.ru/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "https://calendar.reserve-me.ru"
      ],
      "protocolMappers": [
        {
          "name": "ago-calendar-console-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ago-calendar-console",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ago-demo-provisioner",
      "name": "AGO demo tenant provisioner (8-07)",
      "description": "Service account for Ago.Chat.Api/Worker to create and delete minted demo users. Holds realm-management:manage-users on this realm only - see ago-root/docs/adr/0058. Secret comes from infra-credentials, never this file.",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000000004",
      "username": "demo-operator",
      "email": "demo-operator@example.test",
      "firstName": "Demo",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "demo-operator-password",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000005",
      "username": "demo-admin",
      "email": "demo-admin@example.test",
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "demo-admin-password",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-00000000000b",
      "username": "demo-operator-2",
      "email": "demo-operator-2@example.test",
      "firstName": "Demo",
      "lastName": "Operator2",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "demo-operator-2-password",
          "temporary": false
        }
      ]
    }
  ],
  "loginTheme": "ago"
}
