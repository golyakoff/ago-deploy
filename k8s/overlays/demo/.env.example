# Copy to .env (gitignored) before `kubectl apply -k k8s/overlays/demo`. UNLIKE overlays/local/
# .env.example, these are NOT throwaway dev values to reuse as-is - this overlay is a real, public
# deployment (adr/0026), so every value below must be freshly generated on (or for) the real VPS, by
# the author, in a session with real access to it. This file documents the *shape*, never a real
# value (docs/architecture/repositories.md - "no secrets, ever," including "not in a fixture, not in
# a commit meant to be fixed later").
#
# Generate real values with, e.g.:
#   openssl rand -base64 32     # for the two key-shaped values below
#   openssl rand -base64 24     # for a strong password-shaped value
# then paste each result in place of the placeholder text - never commit the resulting .env.

POSTGRES_USER=ago
POSTGRES_PASSWORD=<generate-a-real-password-do-not-commit>
POSTGRES_DB=ago_chat

RABBITMQ_USER=ago
RABBITMQ_PASSWORD=<generate-a-real-password-do-not-commit>

MINIO_ROOT_USER=ago
MINIO_ROOT_PASSWORD=<generate-a-real-password-do-not-commit>

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=<generate-a-real-password-do-not-commit>

# `15-01`/`adr/0036`: Keycloak's own Postgres role. It owns the separate `keycloak` database inside the
# same Postgres Deployment that holds `ago_chat` - a distinct role, not POSTGRES_USER, so a compromise
# of the IdP's database credentials does not hand over the application's own database as well.
#
# ADDING THIS TO AN EXISTING .env IS MANDATORY BEFORE `kubectl apply -k` picks up `15-01`: without it
# Keycloak's init container fails with "KEYCLOAK_DB_PASSWORD: not set" and the pod never starts.
# Also note KEYCLOAK_ADMIN_PASSWORD above becomes first-boot-only from `15-01` onward - Keycloak now
# has a database that remembers the admin account, so editing that value no longer changes an admin
# that already exists (docs/runbooks/public-deploy.md says what to do instead).
KEYCLOAK_DB_PASSWORD=<generate-a-real-password-do-not-commit>

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<generate-a-real-password-do-not-commit>

# 3-06/adr/0026: shared across every Ago.Chat.Api replica so a token issued by one pod validates on
# any other (no sticky sessions - edge.md). base64, 32 bytes, HMAC-SHA256 - `openssl rand -base64 32`.
# A real signing key, unlike overlays/local/'s committed throwaway value - anyone who reads this key
# could forge a visitor session token against the real public deployment.
AUTH_JWT_SIGNING_KEY=<generate-a-real-key-do-not-commit>

# `7-03`'s Grafana/Prometheus stack ships in this overlay too (deploy/k8s/base/kustomization.yaml) -
# same GRAFANA_ADMIN_* pair as overlays/local/, generated fresh here since Grafana would otherwise be
# reachable at a public hostname with the local throwaway password.
