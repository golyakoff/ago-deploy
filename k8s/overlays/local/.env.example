# Copy to .env (gitignored) before running `docker compose up`. These are throwaway local
# development credentials for containers that only ever listen on localhost - never real secrets,
# and never used anywhere but this compose file (docs/architecture/repositories.md: "no secrets,
# ever" - local values live in gitignored files, the repository carries .example files only).

POSTGRES_USER=ago
POSTGRES_PASSWORD=ago-local-dev
POSTGRES_DB=ago_chat

RABBITMQ_USER=ago
RABBITMQ_PASSWORD=ago-local-dev

MINIO_ROOT_USER=ago
MINIO_ROOT_PASSWORD=ago-local-dev

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=ago-local-dev

# `15-01`: Keycloak's own Postgres role (database `keycloak`, same Postgres server as the app's own
# database - adr/0036). Created and kept in sync by the keycloak-db-init step, so changing it here and
# restarting Keycloak is a complete password rotation.
KEYCLOAK_DB_PASSWORD=ago-local-dev

# `7-03`: same value as docker/.env.example - Grafana's admin user, env-var-driven like every other
# credential in this file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ago-local-dev

# `10-05`: where Keycloak sends its verification and password-reset mail. Locally that is the mailpit
# Deployment this overlay adds (mailpit.yaml) - it accepts everything on 1025, forwards nothing, and
# shows the result in a web UI (`kubectl port-forward -n ago-chat svc/mailpit 8025:8025`, then
# http://localhost:8025). No credentials, because there is nothing to authenticate to.
#
# Read by `k8s/apply-smtp-settings.sh`, not by Keycloak - SMTP is a realm setting, so it is applied to
# the realm after the stack is up, not baked into the manifest:
#
#   cd C:/git/ago/ago-deploy
#   k8s/apply-smtp-settings.sh
#
# `.local` in the sender address is a reserved name that can never resolve to anyone real (RFC 6762) -
# a local sink should be incapable of impersonating the actual sending domain.
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@ago-chat.local
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=AGO Chat (local)
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_SSL=false

# 3-06: shared across all Ago.Chat.Api replicas so a token issued by one pod validates on any other
# (no sticky sessions - edge.md) - base64, 32 bytes, HMAC-SHA256. A throwaway dev value like every
# other credential in this file, not a real secret.
#
# `17-03`/ago-root `adr/0067`: base/api.yaml still passes this as `Auth__SigningKey`, which
# Ago.Chat.Api reads as "a key set of exactly one active key". The rotatable multi-key form
# (`Auth__VisitorSigningKeys__*`) is what the demo overlay moves to at its first rotation; there is
# nothing to rotate locally, so this loop stays on the single value. Practising the rotation against
# this cluster is a reasonable thing to do, and ago-root `docs/runbooks/secret-rotation.md` is the
# procedure to practise.
AUTH_JWT_SIGNING_KEY=gC59Z8F8fiwSpdQ2uUm58upzIKyAHbhoP85veFuROzQ=

# `8-07`/ago-root `adr/0058`: the `ago-demo-provisioner` client secret. Consumed by base/api.yaml and
# base/worker.yaml since `8-07`, documented in neither .env.example until `17-03`'s inventory sweep.
#
# **Not required in this overlay**, because base/api.yaml and base/worker.yaml leave
# DemoTenant__Enabled at "false" here and the credential is only required when it is on
# (AddKeycloakDemoIdentities). A throwaway local value, present so that turning the flag on locally
# is one edit rather than a hunt - and so that this file and the demo overlay's list the same keys.
KEYCLOAK_DEMO_PROVISIONER_SECRET=ago-local-dev
